#!/usr/bin/env bash
set -Eeuo pipefail

# Installed-SC targeted hotfix
# Fixes: HTTPUpgrade TLS, VLESS/VMess TCP TLS 2083, TCP non-TLS 80,
# Debian 13/Ubuntu 26 restore gdown --fuzzy issue, and unified output formatting.

if [[ $EUID -ne 0 ]]; then
  echo "[ERROR] Run this script as root."
  exit 1
fi

TS=$(date +%Y%m%d-%H%M%S)
BK="/root/sc-hotfix-backup-$TS"
mkdir -p "$BK"

echo "[INFO] Backup directory: $BK"

backup_one() {
  local f="$1"
  [[ -e "$f" ]] || return 0
  mkdir -p "$BK$(dirname "$f")"
  cp -a "$f" "$BK$f"
}

for f in   /etc/funny/json/tcp.json   /etc/funny/config/http/http-upgrade.conf   /etc/haproxy/haproxy.cfg   /usr/local/rere/restore   /usr/local/rere/xray-family-show; do
  backup_one "$f"
done

command -v jq >/dev/null 2>&1 || { apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y jq; }

# 1) Preserve existing accounts; only disable PROXY protocol expectation on TCP inbounds.
TCPJSON=/etc/funny/json/tcp.json
if [[ -f "$TCPJSON" ]]; then
  tmp=$(mktemp)
  jq '(.inbounds[] | select(.streamSettings.network == "tcp") | .streamSettings.tcpSettings.acceptProxyProtocol) = false' "$TCPJSON" > "$tmp"
  jq empty "$tmp"
  cat "$tmp" > "$TCPJSON"
  rm -f "$tmp"
  chmod 644 "$TCPJSON"
  echo "[OK] Xray TCP acceptProxyProtocol disabled without deleting existing accounts."
else
  echo "[WARN] $TCPJSON not found; skipped TCP JSON patch."
fi

# 2) Replace only the dedicated HTTP Upgrade nginx include with the fixed tunnel settings.
mkdir -p /etc/funny/config/http
printf '%s' '' | base64 -d > /etc/funny/config/http/http-upgrade.conf
chmod 644 /etc/funny/config/http/http-upgrade.conf

echo "[OK] HTTP Upgrade nginx tunnel settings patched."

# 3) Ensure HAProxy multipurpose TLS frontend really listens on 443 and 2083.
HAP=/etc/haproxy/haproxy.cfg
if [[ -f "$HAP" ]]; then
python3 - "$HAP" <<'PYHAP'
import sys,re
p=sys.argv[1]
s=open(p).read().splitlines()
try:
    start=next(i for i,l in enumerate(s) if re.match(r'^frontend\s+multipurpose_tls\s*$',l.strip()))
except StopIteration:
    print('[WARN] frontend multipurpose_tls not found; HAProxy bind patch skipped.')
    raise SystemExit(0)
end=len(s)
for i in range(start+1,len(s)):
    if re.match(r'^(frontend|backend|listen)\s+',s[i].strip()):
        end=i; break
block=s[start:end]
existing='\n'.join(block)
insert=[]
if not re.search(r'^\s*bind\s+\*:443(?:\s|$)',existing,re.M): insert.append('    bind *:443 tfo')
if not re.search(r'^\s*bind\s+\*:2083(?:\s|$)',existing,re.M): insert.append('    bind *:2083 tfo')
if insert:
    pos=start+1
    while pos<end and (not s[pos].strip() or s[pos].lstrip().startswith('#')): pos+=1
    s[pos:pos]=insert
    open(p,'w').write('\n'.join(s)+'\n')
    print('[OK] Added missing HAProxy bind(s): '+', '.join(x.split()[1] for x in insert))
else:
    print('[OK] HAProxy 443 and 2083 binds already exist.')
PYHAP
fi

# 4) Restore hotfix: HTTP(S)/GitHub uses curl; gdown only Google Drive and never --fuzzy.
mkdir -p /usr/local/rere
printf '%s' '' | base64 -d > /usr/local/rere/restore
chmod +x /usr/local/rere/restore

# 5) Unified account output: ports below Host/IP + blank line between each link.
printf '%s' '' | base64 -d > /usr/local/rere/xray-family-show
chmod +x /usr/local/rere/xray-family-show

echo "[OK] Restore and account output scripts patched."

# Validation before restart.
FAIL=0
if [[ -f "$TCPJSON" ]] && ! jq empty "$TCPJSON" >/dev/null 2>&1; then
  echo "[ERROR] Invalid TCP JSON after patch."
  FAIL=1
fi
if command -v nginx >/dev/null 2>&1; then
  if ! nginx -t; then
    echo "[ERROR] nginx validation failed."
    FAIL=1
  fi
fi
if command -v haproxy >/dev/null 2>&1 && [[ -f "$HAP" ]]; then
  if ! haproxy -c -f "$HAP"; then
    echo "[ERROR] HAProxy validation failed."
    FAIL=1
  fi
fi

if (( FAIL )); then
  echo "[ERROR] Validation failed. Files were NOT restarted."
  echo "[INFO] Backup is available at: $BK"
  exit 1
fi

systemctl daemon-reload
restart_if_exists() {
  local u="$1"
  if systemctl cat "$u" >/dev/null 2>&1; then
    systemctl restart "$u"
    echo "[OK] Restarted $u"
  fi
}

restart_if_exists xray-tcp.service
restart_if_exists xray-hu.service
restart_if_exists nginx.service
restart_if_exists haproxy.service

echo
echo "=============================================="
echo " HOTFIX COMPLETED"
echo "=============================================="
echo "Backup : $BK"
echo "Test   :"
echo "  - VLESS/VMess HTTPUpgrade TLS : port 443"
echo "  - VLESS/VMess TCP TLS         : port 2083"
echo "  - VLESS/VMess TCP non-TLS     : port 80"
echo "=============================================="
