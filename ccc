#!/usr/bin/env bash
set -euo pipefail
TS=$(date +%Y%m%d-%H%M%S)
BACKUP="/root/login-live-fix-backup-$TS"
mkdir -p "$BACKUP"
cp -a /usr/local/rere/xray-account "$BACKUP/xray-account" 2>/dev/null || true
cp -a /usr/local/rere/cek-login-ssh "$BACKUP/cek-login-ssh" 2>/dev/null || true

echo '[INFO] Installing SSH/Xray live-login detection fix...'
printf '%s' '' | base64 -d > /usr/local/rere/xray-account
printf '%s' '' | base64 -d > /usr/local/rere/cek-login-ssh
chmod +x /usr/local/rere/xray-account /usr/local/rere/cek-login-ssh

bash -n /usr/local/rere/xray-account
bash -n /usr/local/rere/cek-login-ssh

echo '[OK] Fix installed.'
echo "[INFO] Backup: $BACKUP"
echo '[INFO] SSH quota line removed.'
echo '[INFO] Xray login check now ignores historical/stale access-log entries.'
echo '[INFO] Xray status uses fresh activity (20s window) plus live traffic-counter changes.'
echo '[INFO] Existing VLESS/VMess/Trojan services/configs were not restarted or modified.'
