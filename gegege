#!/usr/bin/env bash
set -u
ROOT=/usr/local/rere
if [[ $EUID -ne 0 ]]; then echo "Run this script as root."; exit 1; fi
if [[ ! -d "$ROOT" ]]; then echo "Cannot find $ROOT"; exit 1; fi
backup="/root/kaizen-menu-expiry-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$backup"
cp -a "$ROOT/menu" "$backup/menu" 2>/dev/null || true

# Main menu boot-loop fix
if [[ -f "$ROOT/menu" ]]; then
  sed -i 's/Input Option \[1-6 or x\]/Input Option [1-8 or x]/g; s/case \$lahiya in/case $lahyes in/g' "$ROOT/menu"
fi

# Fix expiry variable mismatch only in scripts that read input into masaactive.
while IFS= read -r -d '' f; do
  if grep -qE 'read -p .*masaactive[[:space:]]*$' "$f" && grep -q 'masaaktif' "$f"; then
    cp -a "$f" "$backup/$(basename "$f")" 2>/dev/null || true
    sed -i 's/masaaktif/masaactive/g' "$f"
  fi
done < <(find "$ROOT" -type f -print0)

# Combined creators: function is cek_email_all, so call the same name.
for f in "$ROOT/add-vless" "$ROOT/add-vmess" "$ROOT/add-trojan"; do
  [[ -f "$f" ]] || continue
  sed -i 's/if check_email_all "\$email"; then/if cek_email_all "$email"; then/g' "$f"
done

chmod +x "$ROOT"/* 2>/dev/null || true

echo "Checking shell syntax..."
errors=0
while IFS= read -r -d '' f; do
  if head -n1 "$f" | grep -qE '^#!.*(bash|sh)'; then
    if ! bash -n "$f"; then errors=$((errors+1)); fi
  fi
done < <(find "$ROOT" -type f -print0)

if (( errors > 0 )); then
  echo "Hotfix applied, but $errors script(s) have syntax errors. Backup: $backup"
  exit 1
fi

echo "Hotfix applied successfully."
echo "Backup: $backup"
echo "Run: menu"
