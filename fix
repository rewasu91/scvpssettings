#Backup Setup
# Install rclone secara non-interactive. Utamakan package distro (lebih stabil pada Debian 13/Ubuntu 26),
# dan gunakan installer rasmi hanya sebagai fallback. Semua proses mempunyai timeout + live progress.
run_with_progress() {
    local timeout_sec="$1"; shift
    local label="$1"; shift
    local log_file="/tmp/rclone-progress.$$.log"

    timeout --foreground "${timeout_sec}s" "$@" >"$log_file" 2>&1 &
    local pid=$! elapsed=0 spin='|/-\\' i=0
    while kill -0 "$pid" 2>/dev/null; do
        local bars=$((elapsed/2)); (( bars > 30 )) && bars=30
        printf "\r[%-30s] %3ds %s %c" "$(printf '%*s' "$bars" '' | tr ' ' '=')" "$elapsed" "$label" "${spin:i++%4:1}"
        sleep 1
        elapsed=$((elapsed+1))
    done
    wait "$pid"
    local rc=$?
    printf "\r%-90s\r" ""

    if [[ $rc -eq 124 ]]; then
        echo "[WARN] Timeout selepas ${timeout_sec}s: $label"
    elif [[ $rc -ne 0 ]]; then
        echo "[WARN] Gagal: $label (code $rc)"
    fi
    [[ $rc -ne 0 ]] && tail -n 15 "$log_file" 2>/dev/null
    rm -f "$log_file"
    return $rc
}

install_rclone_noninteractive() {
    echo "Memulai pemasangan rclone..."

    if command -v rclone >/dev/null 2>&1; then
        echo "[OK] rclone sudah terpasang: $(rclone version 2>/dev/null | head -n1)"
        return 0
    fi

    # Debian 13 dan Ubuntu 26 menyediakan rclone dalam repository distro.
    # Ini mengelakkan installer curl rasmi yang kadang-kadang mengambil masa sangat lama.
    if run_with_progress 120 "Installing rclone melalui APT..." \
        env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends rclone; then
        command -v rclone >/dev/null 2>&1 && {
            echo "[OK] rclone berhasil dipasang melalui APT."
            return 0
        }
    fi

    echo "[WARN] APT rclone gagal/tidak tersedia. Mencoba installer rasmi sebagai fallback..."
    local tmp_script="/tmp/rclone-install.sh"
    if ! curl -4 -fsSL --connect-timeout 10 --max-time 30 https://rclone.org/install.sh -o "$tmp_script"; then
        echo "[WARN] Gagal download installer rclone. Pemasangan rclone dilewati agar installer utama tidak tersangkut."
        return 1
    fi

    chmod +x "$tmp_script"
    if run_with_progress 90 "Installing rclone melalui fallback..." bash "$tmp_script"; then
        rm -f "$tmp_script"
        command -v rclone >/dev/null 2>&1 && {
            echo "[OK] rclone berhasil dipasang melalui fallback."
            return 0
        }
    fi

    rm -f "$tmp_script"
    echo "[WARN] rclone gagal dipasang, tetapi proses instalasi utama akan diteruskan."
    return 1
}

