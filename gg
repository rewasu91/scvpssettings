#!/bin/bash

SOCKS_IP="45.128.54.130"
SOCKS_PORT="4000"

echo "[1] Updating system..."
apt update -y

echo "[2] Installing tools..."
apt install -y proxychains4 curl wget nano net-tools dnsutils

echo "[3] Backup old proxychains config..."
cp /etc/proxychains4.conf /etc/proxychains4.conf.bak 2>/dev/null

echo "[4] Writing new proxychains config..."
cat > /etc/proxychains4.conf <<EOF
strict_chain
proxy_dns
tcp_read_time_out 15000
tcp_connect_time_out 8000

[ProxyList]
socks5 $SOCKS_IP $SOCKS_PORT
EOF

echo "[5] Testing direct IP..."
DIRECT_IP=$(curl -s --max-time 10 ifconfig.me)
echo "Direct IP: $DIRECT_IP"

echo "[6] Testing SOCKS IP..."
PROXY_IP=$(proxychains4 -q curl -s --max-time 20 ifconfig.me)
echo "Proxy IP: $PROXY_IP"

echo ""
if [ -z "$PROXY_IP" ]; then
  echo "ERROR: SOCKS proxy tidak response."
  echo "Check IP/port/firewall SOCKS."
  exit 1
fi

echo "DONE."
echo "Untuk run app melalui SOCKS:"
echo "proxychains4 curl ifconfig.me"
echo "proxychains4 chromium"
echo "proxychains4 node app.js"
echo "proxychains4 python3 app.py"
