#!/usr/bin/env bash
set -euo pipefail

TARGET=/usr/local/rere/xray-account
[[ -f "$TARGET" ]] || { echo "[ERROR] $TARGET not found."; exit 1; }

BACKUP="${TARGET}.bak-checklogin-$(date +%Y%m%d-%H%M%S)"
cp -a "$TARGET" "$BACKUP"
echo "[INFO] Backup: $BACKUP"

python3 - "$TARGET" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1])
s=p.read_text()
start=s.find('check_login(){')
end=s.find('\nconfig(){', start)
if start < 0 or end < 0:
    raise SystemExit('[ERROR] check_login/config function anchor not found.')
new=r'''check_login(){
 local p="${1:-}"
 valid_proto "$p" || { echo '[ERROR] Invalid protocol.'; return 1; }
 local log="/var/log/xray/$p.log"
 local title="${p^^} User Login"
 local line='----------------------------------'
 local found=0
 local email ip_limit quota_bytes usage_bytes login_count ip_limit_text quota_text user

 clear
 echo "$line"
 printf '       \033[1;33m[ %s ]\033[0m\n' "$title"
 echo "$line"

 [[ -f "$log" ]] || touch "$log" 2>/dev/null || true

 while IFS='|' read -r email ip_limit quota_bytes; do
   [[ -n "$email" ]] || continue
   login_count=$(
     grep -F "email: $email" "$log" 2>/dev/null \
       | grep -oE 'from [^ ]+' \
       | sed 's/^from //' \
       | sed -E 's/^\[([^]]+)\]:[0-9]+$/\1/; t; s/:([0-9]+)$//' \
       | sort -u \
       | awk 'NF{n++} END{print n+0}'
   )

   if [[ "${login_count:-0}" -eq 0 ]] && grep -Fq "$email" "$log" 2>/dev/null; then
     login_count=$(
       grep -F "$email" "$log" 2>/dev/null \
         | grep -oE 'from [^ ]+' \
         | sed 's/^from //' \
         | sed -E 's/^\[([^]]+)\]:[0-9]+$/\1/; t; s/:([0-9]+)$//' \
         | sort -u \
         | awk 'NF{n++} END{print n+0}'
     )
   fi

   (( login_count > 0 )) || continue
   found=1
   user="${email%@*}"

   if [[ "${ip_limit:-0}" =~ ^[0-9]+$ ]] && (( ip_limit > 0 )); then
     ip_limit_text="$ip_limit"
   else
     ip_limit_text='N/A'
   fi

   usage_bytes=$(cat "$BASE/limit/xray/$p/usage/$email" 2>/dev/null || echo 0)
   [[ "$usage_bytes" =~ ^[0-9]+$ ]] || usage_bytes=0
   [[ "${quota_bytes:-0}" =~ ^[0-9]+$ ]] || quota_bytes=0

   if (( quota_bytes > 0 )); then
     quota_text="$(fmt_bytes "$usage_bytes") / $(fmt_bytes "$quota_bytes")"
   else
     quota_text='N/A / N/A'
   fi

   printf 'User  : %s\n' "$user"
   printf 'Login : %s / %s IP\n' "$login_count" "$ip_limit_text"
   printf 'Quota : %s\n' "$quota_text"
   echo "$line"
 done < <(sqlite3 -separator '|' "$DB" "SELECT email,ip_limit,quota_bytes FROM accounts WHERE protocol='$p' ORDER BY email;")

 if (( found == 0 )); then
   echo 'No active user login.'
   echo "$line"
 fi
}'''
p.write_text(s[:start] + new + s[end:])
PY

chmod +x "$TARGET"
if ! bash -n "$TARGET"; then
  echo '[ERROR] Syntax validation failed. Restoring backup.'
  cp -a "$BACKUP" "$TARGET"
  exit 1
fi

echo '[OK] Check Login Account display has been updated.'
echo '[INFO] Test from menu: Xray > VLESS/VMess/Trojan > Check Login Account'
